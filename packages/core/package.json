{
  "name": "@tetraslam/kiseki-core",
  "version": "0.1.0",
  "description": "Parse, validate, and normalize OpenTraces records for kiseki. No React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
